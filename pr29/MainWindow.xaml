<Window x:Class="pr29.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr29"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid Margin="10" Background="LightGray">
		<Grid.RowDefinitions>
			<RowDefinition Height="40"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="55"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Image Processing"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

		<Grid Grid.Row="1" Margin="0,5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" BorderThickness="1" Margin="3">
				<Image x:Name="myImg" Stretch="Uniform"/>
			</Border>

			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Image x:Name="redImg"
                       Grid.Row="0" Grid.Column="0" Stretch="Uniform" Margin="3"/>

				<Image x:Name="greenImg"
                       Grid.Row="0" Grid.Column="1" Stretch="Uniform" Margin="3"/>

				<Image x:Name="blueImg"
                       Grid.Row="1" Grid.Column="0" Stretch="Uniform" Margin="3"/>

				<Image x:Name="grayImg"
                       Grid.Row="1" Grid.Column="1" Stretch="Uniform" Margin="3"/>
			</Grid>
		</Grid>

		<UniformGrid Grid.Row="2" Columns="5">
			<Button Content="Red Channel" Margin="3" Click="Red_Click"/>

			<Button Content="Green Channel" Margin="3" Click="Green_Click"/>

			<Button Content="Blue Channel" Margin="3" Click="Blue_Click"/>

			<Button Content="Negative" Margin="3" Click="Negative_Click"/>

			<Button Content="📂Открыть" Margin="3" Click="Open_Click"/>

		</UniformGrid>
	</Grid>
</Window>
